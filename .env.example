# ========================================================
# Rangkum.in (Voice to Minutes AI) — Environment Variables
# Salin berkas ini menjadi .env di root proyek:
#   copy .env.example .env
# ========================================================

# Port Server Backend API
PORT=3001
NODE_ENV=development

# CORS Frontend Origin
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------
# Provider AI Settings
# --------------------------------------------------------
# Pilihan STT Provider: "mock" | "groq" | "openai"
# "mock" hanya untuk demo/test; gunakan groq atau openai untuk STT audio nyata.
# Provider eksternal tanpa API key akan mengembalikan error konfigurasi (tanpa fallback mock).
STT_PROVIDER=mock

# Pilihan LLM Provider: "mock" | "groq" | "openai" | "gemini"
# Default: "mock" (berfungsi tanpa API key untuk pengujian)
LLM_PROVIDER=mock

# --------------------------------------------------------
# External AI Provider API Keys (Opsional bila menggunakan Mock)
# --------------------------------------------------------
# Groq Cloud API (Whisper STT & LLM)
# Dapatkan dari: https://console.groq.com/keys
GROQ_API_KEY=
# Model Groq LLM (default: openai/gpt-oss-120b; alternatif: openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_LLM_MODEL=openai/gpt-oss-120b

# OpenAI API (Whisper-1 & GPT-4o-mini)
# Dapatkan dari: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --------------------------------------------------------
# Batasan Audio & Pipeline
# --------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SEC=7200
