{
  "name": "rangkumin-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@rangkumin/web",
    "dev:api": "npm run dev --workspace=@rangkumin/api",
    "dev:web": "npm run dev --workspace=@rangkumin/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  }
}
